# ── Pin assignments ────────────────────────────────────────────────────────
# PA4  : CS (MCP3465R chip-select, active-low GPIO output)
# PA5  : SPI1_SCK
# PA6  : SPI1_MISO
# PA7  : SPI1_MOSI
# PA9  : USART1_TX  (debug via ST-Link VCP)
# PA10 : USART1_RX
# PC13 : GPIO_EXTI13 (MCP3465R /IRQ — optional, polled in this project)
# PH0  : RCC_OSC_IN  (not used, HSI selected)
# PH1  : RCC_OSC_OUT
PA4.GPIOParameters=GPIO_Label,GPIO_PuPd,GPIO_ModeDefaultOutputPP
PA4.GPIO_Label=MCP_CS
PA4.GPIO_ModeDefaultOutputPP=GPIO_MODE_OUTPUT_PP
PA4.GPIO_PuPd=GPIO_NOPULL
PA4.Locked=true
PA4.Signal=GPIO_Output

PA5.Locked=true
PA5.Signal=SPI1_SCK

PA6.Locked=true
PA6.Signal=SPI1_MISO

PA7.Locked=true
PA7.Signal=SPI1_MOSI

PA9.Locked=true
PA9.Signal=USART1_TX

PA10.Locked=true
PA10.Signal=USART1_RX

PC13.GPIOParameters=GPIO_Label,GPIO_PuPd,GPIO_Mode
PC13.GPIO_Label=MCP_IRQ
PC13.GPIO_Mode=GPIO_MODE_INPUT
PC13.GPIO_PuPd=GPIO_PULLUP
PC13.Locked=true
PC13.Signal=GPXTI13

# ── RCC ────────────────────────────────────────────────────────────────────
# HSI16 → PLL → SYSCLK 110 MHz
# PLLM=2, PLLN=55, PLLR=4  → 16/2 × 55 / 4 = 110 MHz
RCC.ADCFreq_Value=110000000
RCC.AHBFreq_Value=110000000
RCC.APB1Freq_Value=110000000
RCC.APB2Freq_Value=110000000
RCC.CortexFreq_Value=110000000
RCC.FCLKCortexFreq_Value=110000000
RCC.FamilyName=M
RCC.HCLKFreq_Value=110000000
RCC.HSI16_VALUE=16000000
RCC.IPParameters=ADCFreq_Value,AHBFreq_Value,APB1Freq_Value,APB2Freq_Value,CortexFreq_Value,FCLKCortexFreq_Value,FamilyName,HCLKFreq_Value,HSI16_VALUE,MCOFreq_Value,PLLFreq_Value,PLLMCOFreq_Value,PLLM,PLLN,PLLPoutputFreq_Value,PLLR,PLLRCLKFreq_Value,PLLSAIoutputFreq_Value,SYSCLKFreq_VALUE,SYSCLKSource,TimSysFreq_Value,USART1Freq_Value,VCOOutputFreq_Value
RCC.MCOFreq_Value=16000000
RCC.PLLM=2
RCC.PLLN=55
RCC.PLLR=4
RCC.PLLFreq_Value=110000000
RCC.PLLRCLKFreq_Value=110000000
RCC.SYSCLKFreq_VALUE=110000000
RCC.SYSCLKSource=RCC_SYSCLKSOURCE_PLLCLK
RCC.TimSysFreq_Value=110000000
RCC.USART1Freq_Value=110000000
RCC.VCOOutputFreq_Value=440000000

# ── SPI1 ────────────────────────────────────────────────────────────────────
# MCP3465R: Mode 0,0 (CPOL=Low, CPHA=1Edge), 8-bit MSB, up to 20 MHz
# 110 MHz / 8 = 13.75 MHz → within MCP3465R spec
SPI1.BaudRatePrescaler=SPI_BAUDRATEPRESCALER_8
SPI1.CLKPhase=SPI_PHASE_1EDGE
SPI1.CLKPolarity=SPI_POLARITY_LOW
SPI1.DataSize=SPI_DATASIZE_8BIT
SPI1.Direction=SPI_DIRECTION_2LINES
SPI1.FirstBit=SPI_FIRSTBIT_MSB
SPI1.IPParameters=VirtualType,Mode,Direction,DataSize,CLKPolarity,CLKPhase,NSS,BaudRatePrescaler,FirstBit,TIMode,CRCCalculation,NSS,NSSPolarity
SPI1.Mode=SPI_MODE_MASTER
SPI1.NSS=SPI_NSS_SOFT
SPI1.NSSPolarity=SPI_NSS_POLARITY_LOW
SPI1.TIMode=SPI_TIMODE_DISABLE
SPI1.VirtualType=VM_MASTER

# ── USART1 (debug / retarget printf) ────────────────────────────────────────
USART1.BaudRate=115200
USART1.IPParameters=VirtualMode,BaudRate
USART1.VirtualMode=VM_ASYNC

